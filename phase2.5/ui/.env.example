# phase2.5/ui/.env.example
# Copy this to .env and update with your values

# Core API Configuration
VITE_API_BASE_URL=http://localhost:5317

# Alternative API URL (if port 5317 is busy)
# VITE_API_BASE_URL=http://localhost:5318

# LiveKit Configuration (optional - for direct UI connection)
VITE_LIVEKIT_URL=wss://rika-marzcsys.livekit.cloud

# Feature Flags
VITE_ENABLE_STREAMING=true
VITE_ENABLE_CONTROL=true
VITE_ENABLE_GESTURES=true

# UI Settings
VITE_REFRESH_INTERVAL=5000
VITE_THUMBNAIL_UPDATE_INTERVAL=10000
VITE_SESSION_TIMEOUT_MINUTES=60

# Debug Mode
VITE_DEBUG=false