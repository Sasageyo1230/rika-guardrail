{
  "streaming": {
    "enabled": true,
    "max_concurrent": 5,
    "max_fps": 15,
    "max_resolution": "720p",
    "bitrate_limit_kbps": 2000
  },
  "control": {
    "enabled": true,
    "require_approval": true,
    "max_ttl_minutes": 30,
    "allowed_input_types": [
      "mouse_move",
      "mouse_click",
      "mouse_scroll",
      "key_press",
      "key_release"
    ],
    "blocked_keys": [
      "win+l",
      "ctrl+alt+del",
      "alt+f4"
    ]
  },
  "security": {
    "watermark_required": true,
    "consent_banner_required": true,
    "audit_logging": true,
    "max_session_duration_hours": 2
  },
  "overseer": {
    "enabled": false,
    "endpoint": "http://localhost:9999/policy",
    "timeout_seconds": 5
  }
}