# phase3/l2-autonomy/.env.example

# Database Configuration
DATABASE_URL=postgresql://rika_admin:RikaPostgres2025SecureDB@localhost:5433/rika_core

# Service Dependencies
OVERSEER_URL=http://localhost:5319
SAGE_URL=http://localhost:5320
EVAL_URL=http://localhost:5321
CORE_API_URL=http://localhost:5317

# Autonomy Configuration
INITIAL_AUTONOMY_LEVEL=disabled
DEFAULT_MAX_FILES=5
DEFAULT_MAX_LINES_PER_FILE=100
DEFAULT_TIMEOUT_MINUTES=30

# Agent Configuration
AGENT_SCOUT_PATH=agents/scout.py
AGENT_CRAFT_PATH=agents/craft.py

# Safety Settings
REQUIRE_TESTS=true
REQUIRE_EVAL_PASS=true
ROLLBACK_ON_FAILURE=true
HUMAN_NOTIFICATION=true

# Monitoring and Alerts
ENABLE_HUD=false
TEST_MODE=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=autonomy.log