# Rika Phase 3.5 Environment Configuration Example
# Copy this file to .env and fill in your actual API keys

# LLM Provider Configuration
LLM_PROVIDER=anthropic
MODEL_NAME=claude-3-haiku-20240307
GUARDED=false

# API Keys (Replace with your actual keys)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# Local LLM Configuration (Ollama)
LOCAL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama2

# Memory and Database
MEMORY_PROVIDER=json
DATABASE_URL=postgresql://user:password@localhost:5432/rika

# n8n Workflow Integration
N8N_BASE_URL=http://localhost:5324
N8N_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS Origins
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:5174"]
