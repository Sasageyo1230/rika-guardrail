{
  "name": "rika-atlas-ui",
  "version": "3.4.0",
  "description": "Rika Phase 3.4 Atlas UI - AI-Powered Development Assistant Interface",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
