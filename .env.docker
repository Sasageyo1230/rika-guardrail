# ===========================================
# RIKA CORE - Environment Configuration
# ===========================================
# Copy this file to .env and update with your values
# WARNING: Never commit .env to version control!

# General Settings
TIMEZONE=America/New_York
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ===========================================
# PostgreSQL Configuration
# ===========================================
POSTGRES_VERSION=17-alpine
POSTGRES_DB=rika_core
POSTGRES_USER=rika_admin
POSTGRES_PASSWORD=RikaPostgres2025SecureDB
POSTGRES_PORT=5433

# ===========================================
# Qdrant Vector Database
# ===========================================
QDRANT_VERSION=v1.7.4
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===========================================
# NATS Messaging
# ===========================================
NATS_VERSION=2.10-alpine
NATS_USER=rika_nats
NATS_PASSWORD=NatsMsg2025RikaCore789
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# ===========================================
# LiveKit WebRTC
# ===========================================
LIVEKIT_VERSION=v1.5.3
LIVEKIT_API_KEY=APIrika1234567890
LIVEKIT_API_SECRET=LiveKitSecret2025WebRTCRika
LIVEKIT_PORT=7880
LIVEKIT_RTC_PORT=7881

# ===========================================
# n8n Workflow Automation
# ===========================================
N8N_VERSION=1.23.0
N8N_DB_NAME=n8n_db
N8N_BASIC_AUTH_USER=rika_n8n
N8N_BASIC_AUTH_PASSWORD=N8nWorkflow2025RikaAuto
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/

# ===========================================
# MinIO Object Storage
# ===========================================
MINIO_VERSION=RELEASE.2024-01-16T16-07-38Z
MINIO_ROOT_USER=rika_minio_admin
MINIO_ROOT_PASSWORD=MinioStorage2025RikaS3Obj
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===========================================
# Keycloak Authentication
# ===========================================
KEYCLOAK_VERSION=24.0
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_ADMIN=rika_keycloak
KEYCLOAK_ADMIN_PASSWORD=KeycloakAuth2025RikaSSO
KEYCLOAK_PORT=8080

# ===========================================
# Backup Configuration
# ===========================================
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_PATH=./backups
BACKUP_MINIO_BUCKET=rika-backups